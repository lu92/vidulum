<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.multi</groupId>
        <artifactId>vidulum</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>vidulum-okx</artifactId>
    <name>Vidulum OKX Module</name>
    <description>OKX exchange integration: quotation provider, exchange connection</description>

    <dependencies>
        <!-- Shared Kernel -->
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-shared-kernel</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Exchange contract: OkxExchangeAdapter implements its SPI. -->
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-exchange-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Quotation contract: what portfolio, pnl, risk and portfolio_spec may ask about prices.
             The implementation (QuotationService, NBP, the caches) stays private to this module. -->
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-quotation-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- The exchange implementation, for the endpoint tests that stand up a real connection.
             Test scope only: OkxExchangeAdapter compiles against the SPI in vidulum-exchange-api,
             so this module needs nothing of the connection aggregate at build time. -->
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-exchange</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Wealth: BrokerQuotationProvider and QuotationService live here.
             The dependency points this way on purpose: wealth must stay unaware of OKX,
             otherwise registering the provider would create a cycle. -->
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-wealth</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-classic</artifactId>
        </dependency>



        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- The quotation implementation, for integration tests that seed prices through
             QuoteRestController and for component tests that drive the real QuotationService.
             Test scope only: nothing in src/main may see it. -->
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-quotation</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test-classic</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-resttestclient</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
