<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.multi</groupId>
        <artifactId>vidulum</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>vidulum-app</artifactId>
    <name>Vidulum Application</name>
    <description>Main Spring Boot application - all business modules</description>

    <dependencies>
        <!-- Shared Kernel -->
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-shared-kernel</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- CashFlow Module -->
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-cashflow</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Bank data ingestion: left vidulum-cashflow and so the bootstrap names it directly.
             It arrives here at compile scope and nowhere else at compile scope, which is the rule
             for every implementation module. -->
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-bank-data-ingestion</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Recurring rules: an implementation module like any other, so the bootstrap names it.
             It used to arrive transitively through vidulum-cashflow, which declared it at compile
             scope while using nothing from it - so the only module whose beans reached the
             application by accident rather than by declaration. -->
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-recurring-rules</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- PnL and risk. Leaves: they consume contracts and answer over HTTP, and this is the
             only module that wires them. vidulum-wealth-tests is not here - it holds nothing but
             the tests that deliberately cross a module boundary. -->
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-pnl</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-risk</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- The portfolio and trading implementations. Only this module wires them. -->
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-portfolio</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-trading</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- The portfolio contract: the user domain opens a portfolio through it. -->
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-portfolio-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- The only module that wires the quotation implementation into a running application. -->
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-quotation</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- OKX exchange integration: brings OkxQuotationConfiguration onto the classpath
             so component scanning registers the provider -->
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-exchange</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-okx</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-classic</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- Security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Libraries -->
        <dependency>
            <groupId>io.vavr</groupId>
            <artifactId>vavr</artifactId>
            <version>0.10.4</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>1.10.0</version>
        </dependency>
        <dependency>
            <groupId>org.iban4j</groupId>
            <artifactId>iban4j</artifactId>
            <version>3.2.7-RELEASE</version>
        </dependency>

        <!-- Spring AI -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-anthropic</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- Lombok -->

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-resttestclient</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mongodb</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <version>4.2.2</version>
            <scope>test</scope>
        </dependency>

        <!-- ArchUnit runs here because this is the only module that sees every implementation on
             its classpath: the boundary rules it checks are about modules it alone puts together. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
