<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.multi</groupId>
        <artifactId>vidulum</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>vidulum-risk</artifactId>
    <name>Vidulum Risk Management Module</name>
    <description>
        Risk assessment: RAG status per position, stop-loss coverage, how much of a portfolio is at
        risk. Stores nothing - every answer is composed from three other modules' contracts. A leaf,
        like vidulum-pnl, so there is no vidulum-risk-api either.
    </description>

    <dependencies>
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-shared-kernel</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Contracts only. The implementations are wired by vidulum-app. -->
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-portfolio-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-trading-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-quotation-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-classic</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson2</artifactId>
        </dependency>

    </dependencies>

</project>
