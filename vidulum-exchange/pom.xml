<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.multi</groupId>
        <artifactId>vidulum</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>vidulum-exchange</artifactId>
    <name>Vidulum Exchange Module</name>
    <description>Exchange-agnostic model: the link between a user, an exchange account and a portfolio</description>

    <dependencies>
        <!-- Shared Kernel is the ONLY Vidulum dependency, deliberately.
             ExchangeConnection needs UserId, PortfolioId, Currency and Broker - all of which live
             there - so this module can sit before vidulum-wealth in the reactor. That matters:
             PortfolioSpec (D1) lives in wealth and has to read the connection to learn the known
             state, so wealth depends on this module and not the other way round. -->
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-shared-kernel</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-classic</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test-classic</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mongodb</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
