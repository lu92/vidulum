{
  "name": "okx-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Read-only OKX tooling: REST export and private WebSocket listener (no npm dependencies).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node okx-common.test.mjs",
    "export:demo": "node --env-file=.env.demo okx-readonly-export.mjs --profile demo --out demo.json",
    "export:prod": "node --env-file=.env.prod okx-readonly-export.mjs --profile prod --out prod.json",
    "export:demo:quick": "node --env-file=.env.demo okx-readonly-export.mjs --profile demo --skip-bills --out demo.json",
    "export:prod:quick": "node --env-file=.env.prod okx-readonly-export.mjs --profile prod --skip-bills --out prod.json",
    "ws:demo": "node --env-file=.env.demo okx-ws-listener.mjs --profile demo --region eea",
    "ws:prod": "node --env-file=.env.prod okx-ws-listener.mjs --profile prod --region eea",
    "check:demo": "node --env-file=.env.demo okx-readonly-export.mjs --profile demo --verbose --days 1 --out check-demo.json",
    "check:prod": "node --env-file=.env.prod okx-readonly-export.mjs --profile prod --verbose --days 1 --out check-prod.json"
  }
}
