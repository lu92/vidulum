# Szablon poświadczeń OKX. Skopiuj do .env.prod i .env.demo, uzupełnij wartości.
#   cp .env.example .env.prod   # klucz live  (OKX_*)
#   cp .env.example .env.demo   # klucz Demo Trading (OKX_DEMO_*)
# Pliki .env.prod / .env.demo są ignorowane przez git — nie commituj ich.
# Klucze twórz jako READ-ONLY (skrypty wykonują wyłącznie żądania GET).
# UWAGA: jeśli passphrase zawiera znak # (albo spacje), OBOWIĄZKOWO ujmij wartość w cudzysłowy:
#   OKX_PASSPHRASE='moja#fraza'
# Bez tego `node --env-file` potraktuje # jako początek komentarza, obetnie wartość
# i OKX odpowie 50105 "OK-ACCESS-PASSPHRASE incorrect".

# --- REGION / DOMENA ---------------------------------------------------------
# Konto założone na my.okx.com (EEA) => REST na eea.okx.com, WS na wseea.okx.com.
# Konto globalne (okx.com)           => REST na openapi.okx.com (domyślne), WS na ws.okx.com.
# Konto US (okx.com/us)              => WS na wsus.okx.com.
# Zły region to błąd 60032 (REST) albo 50119 (WS/login) — patrz README.
# OKX_DOMAIN / OKX_DEMO_DOMAIN dotyczy REST; regionem WS steruje flaga --region.

# --- PROFIL PROD (klucz live, npm run export:prod / ws:prod / check:prod) -----
OKX_KEY=
OKX_SECRET=
OKX_PASSPHRASE=
# Wymagane dla konta EEA — bez tego skrypt uderza w openapi.okx.com i dostaje 60032:
OKX_DOMAIN=eea.okx.com
# Opcjonalne, nadpisywane przez --region / --ws-url:
# OKX_REGION=eea
# OKX_WS_URL=wss://wseea.okx.com:8443

# --- PROFIL DEMO (klucz Demo Trading, npm run export:demo / ws:demo / check:demo)
# Skrypty dokładają automatycznie nagłówek x-simulated-trading: 1.
OKX_DEMO_KEY=
OKX_DEMO_SECRET=
OKX_DEMO_PASSPHRASE=
OKX_DEMO_DOMAIN=eea.okx.com
# Opcjonalne (WS demo dla EEA to wseeapap.okx.com):
# OKX_DEMO_REGION=eea
# OKX_DEMO_WS_URL=wss://wseeapap.okx.com:8443
