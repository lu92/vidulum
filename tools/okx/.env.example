# OKX credentials template. Copy to .env.prod and .env.demo, then fill in the values.
#   cp .env.example .env.prod   # live key        (OKX_*)
#   cp .env.example .env.demo   # Demo Trading key (OKX_DEMO_*)
# .env.prod / .env.demo are git-ignored - never commit them.
# Create the keys as READ-ONLY: these scripts only ever issue GET requests.
# NOTE: if a passphrase contains a # (or spaces), you MUST quote the value:
#   OKX_PASSPHRASE='my#passphrase'
# Without quotes `node --env-file` treats # as the start of a comment, truncates
# the value, and OKX replies 50105 "OK-ACCESS-PASSPHRASE incorrect".

# --- REGION / DOMAIN ---------------------------------------------------------
# Account opened on my.okx.com (EEA) => REST on eea.okx.com, WS on wseea.okx.com.
# Global account (okx.com)           => REST on openapi.okx.com (default), WS on ws.okx.com.
# US account (okx.com/us)            => WS on wsus.okx.com.
# The wrong region yields error 60032 (REST) or 50119 (WS/login) - see README.
# OKX_DOMAIN / OKX_DEMO_DOMAIN apply to REST; the WS region is set with --region.

# --- PROD PROFILE (live key: npm run export:prod / ws:prod / check:prod) ------
OKX_KEY=
OKX_SECRET=
OKX_PASSPHRASE=
# Required for EEA accounts - without it the script hits openapi.okx.com and gets 60032:
OKX_DOMAIN=eea.okx.com
# Optional, overridden by --region / --ws-url:
# OKX_REGION=eea
# OKX_WS_URL=wss://wseea.okx.com:8443

# --- DEMO PROFILE (Demo Trading key: npm run export:demo / ws:demo / check:demo)
# The scripts add the x-simulated-trading: 1 header automatically.
OKX_DEMO_KEY=
OKX_DEMO_SECRET=
OKX_DEMO_PASSPHRASE=
OKX_DEMO_DOMAIN=eea.okx.com
# Optional (the EEA demo WS host is wseeapap.okx.com):
# OKX_DEMO_REGION=eea
# OKX_DEMO_WS_URL=wss://wseeapap.okx.com:8443
