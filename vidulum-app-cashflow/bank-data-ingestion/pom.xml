<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.multi</groupId>
        <artifactId>vidulum</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>vidulum-bank-data-ingestion</artifactId>
    <name>Vidulum Bank Data Ingestion Module</name>
    <description>
        Bank CSV into a cash flow: staging sessions, category mappings, import jobs, rollback.

        It has no *-api of its own, deliberately: nothing in the codebase asks this module
        anything. It consumes contracts and answers the frontend over REST, which is the same
        reason vidulum-pnl and vidulum-risk have none. A contract gets written when a consumer
        exists.

        Its dependencies are the whole argument for extracting it. 75 of its imports from cashflow
        go through vidulum-cashflow-api and not one touches the aggregate - that was step 15's
        result, and it is what makes this module buildable on its own. It never depends on
        vidulum-cashflow, which is why the parent can depend on this at test scope without a cycle:
        the seven integration tests that need a running cash flow stay in vidulum-cashflow/src/test,
        exactly as vidulum-recurring-rules' do.
    </description>

    <dependencies>
        <!-- Shared Kernel -->
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-shared-kernel</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Contracts, and only contracts. This module names no implementation - and since the
             classification vocabulary turned out to travel as a CSV column rather than as a type,
             it names bank-data-adapter not at all. -->
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-cashflow-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-user-financial-profile-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-bank-data-ai-categorization-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring Boot: it persists, it has endpoints, it validates input, it speaks events -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-classic</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- CSV parsing -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>1.10.0</version>
        </dependency>

        <!-- AI categorization -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- A test-jar, so the seven integration tests left in vidulum-cashflow can use
                 BankDataIngestionHttpActor and the rest of this module's test helpers. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
