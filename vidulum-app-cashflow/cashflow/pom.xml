<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.multi</groupId>
        <artifactId>vidulum</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>vidulum-cashflow</artifactId>
    <name>Vidulum CashFlow Module</name>
    <description>
        The CashFlow aggregate and its read model: categories, bank accounts, the month lifecycle,
        and the Kafka-driven forecast projected from its events.

        Those two packages share an artifact on purpose. cashflow_forecast_processor projects from
        36 imports of CashFlowEvent and shares the aggregate's lifecycle - every new rule in the
        aggregate needs a handler there - so a separate artifact would mean two commits per business
        change. It is the one remaining exemption in ModuleBoundariesArchTest's assertSealed for
        cashflow, and it is deliberate.

        Unit and component tests only: no Spring, no Docker, 91 in five seconds. Everything needing
        a running context lives in vidulum-cashflow-tests - which is why this module has no
        test-scope dependency on any other module.
    </description>

    <dependencies>
        <!-- Shared Kernel -->
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-shared-kernel</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Recurring rules, test scope only: this module's main sources use nothing from it.
             RecurringRulesHttpIntegrationTest lives here because it needs a running cashflow to
             talk to over HTTP, and that test is the whole reason for this dependency. -->
        <!-- user-financial-profile: same arrangement again. Two integration tests here need its
             endpoints together with a running cash flow, so they stay and it comes back at test
             scope. It depends on no cashflow artifact, which is what keeps this acyclic. -->
        <!-- bank-data-adapter: same arrangement. Two integration tests here need both its
             endpoints and a running cash flow, so they stay, and it comes back at test scope. -->
        <!-- bank-data-ingestion left this artifact, and comes back only for tests: seven
             integration tests here need both a running cash flow and the ingestion endpoints, and
             they cannot live in that module - it depends on vidulum-cashflow-api, never on this
             artifact, which is exactly what keeps the reactor acyclic. Same arrangement as
             recurring-rules above. -->
        <!-- CashFlow's own contract: what other modules may ask of it. This module implements it;
             consumers compile against the contract alone. -->
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-cashflow-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- User Financial Profile API (contract) -->
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-user-financial-profile-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-classic</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson2</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- Libraries -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>1.10.0</version>
        </dependency>

        <dependency>
            <groupId>org.iban4j</groupId>
            <artifactId>iban4j</artifactId>
            <version>3.2.7-RELEASE</version>
        </dependency>

        <!-- Spring AI -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-anthropic</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- Lombok -->

        <!-- Test -->
    </dependencies>


    <build>
        <plugins>
            <!-- A test-jar for TestIds and the in-memory repositories: vidulum-cashflow-tests uses
                 them, and they belong here next to the unit tests that are their main consumer. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
