<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.multi</groupId>
        <artifactId>vidulum</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>vidulum-wealth-tests</artifactId>
    <name>Vidulum Wealth Cross-Module Tests</name>
    <description>
        No src/main, and the name says so. Portfolio, trading, quotation, pnl and risk all left for
        their own artifacts (steps 02b-09 of the module split); what stayed are the tests that
        deliberately cross a module boundary and would otherwise force a reactor cycle - portfolio's
        tests needing trading, trading's needing portfolio. Nothing depends on this artifact.
    </description>

    <dependencies>
        <!-- Shared Kernel -->
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-shared-kernel</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- The contracts below are declared at compile scope out of inertia, not need: with no
             main sources they only ever serve the test classpath. Harmless, and worth remembering
             before reading anything into the scopes here. -->

        <!-- Portfolio contract: what trading, pnl, risk and the user domain may ask of a
             portfolio. -->
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-portfolio-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Trading contract: the event a settled trade arrives on, and the shape of handling
             it. TradingModuleApi joins it at step 06. -->
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-trading-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Quotation contract: what portfolio, pnl, risk and portfolio_spec may ask about prices.
             The implementation (QuotationService, NBP, the caches) stays private to this module. -->
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-quotation-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Exchange contract: onboarding closes a connection and records a synchronisation
             through it. The connection aggregate, its repository and its command handlers stay
             private to vidulum-exchange, which only the application and these tests see. -->
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-exchange-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-classic</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- Security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
        </dependency>

        <!-- Lombok -->

        <!-- Test -->

        <!-- The portfolio and trading implementations, for the walks that span both and so
             stayed here: an order is placed, filled, and the balance moves. Test scope only —
             pnl and risk compile against the contracts. -->
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-portfolio</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-portfolio</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-trading</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- ValuationBasisPersistenceTest asserts what Mongo stores, and WealthIntegrationTest
             exposes both modules' controllers to the cross-module walks. -->
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-pnl</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-risk</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- The exchange implementation, for onboarding's component tests, which wire its real
             handlers. Test scope only: nothing in src/main may see it. -->
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-exchange</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- The quotation implementation, for integration tests that seed prices through
             QuoteRestController and for component tests that drive the real QuotationService.
             Test scope only: nothing in src/main may see it. -->
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-quotation</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- TestRestTemplate for the endpoint tests: the actor pattern needs a real HTTP client. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-resttestclient</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mongodb</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The quotation contract's own fake, for tests that need prices but are not about
             prices. See InMemoryQuotationApi. -->
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-quotation-api</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <version>4.2.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
