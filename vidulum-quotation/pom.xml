<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.multi</groupId>
        <artifactId>vidulum</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>vidulum-quotation</artifactId>
    <name>Vidulum Quotation Module</name>
    <description>What an asset is worth: per-broker quote caches, the route through the pivot
        currency, and the central bank fixing. Nobody compiles against this - consumers compile
        against vidulum-quotation-api.</description>

    <dependencies>
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-shared-kernel</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- The contract this module implements. -->
        <dependency>
            <groupId>com.multi</groupId>
            <artifactId>vidulum-quotation-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- QuoteRestController, ExchangeStatusRestController, and the NBP client built with
             HttpServiceProxyFactory. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-classic</artifactId>
        </dependency>

        <!-- Prices arrive on the quotes topic; FxRateRefresher runs on @Scheduled. -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
